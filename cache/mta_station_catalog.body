            "name" : "MTA Subway Stations",
            "id" : "39hk-dx4f",
            "resource_name" : null,
            "parent_fxf" : [],
            "description" : "A dataset listing all subway and Staten Island Railway stations, with information on their locations, Station Master Reference Number (MRN), Complex MRN, GTFS Stop ID, the services that stop there, the type of structure the station is on or in, whether the station is in Manhattan’s Central Business District (CBD), and their ADA-accessibility status.",
            "attribution" : "Metropolitan Transportation Authority",
            "attribution_link" : "https://www.mta.info/open-data",
            "contact_email" : null,
            "type" : "dataset",
            "updatedAt" : "2026-10-03T04:22:20.000Z",
