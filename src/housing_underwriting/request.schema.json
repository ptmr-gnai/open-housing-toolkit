{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-housing-toolkit.local/housing-underwriting/request-1.0.schema.json",
  "$comment": "Executable validation also enforces decimal bounds, time order, unique ids, category coverage and reference integrity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "question",
    "price_basis",
    "program",
    "capital",
    "operations",
    "debt",
    "sources",
    "basis",
    "references"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,80}$"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "price_basis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "homes",
        "gross_area_sf",
        "basis"
      ],
      "properties": {
        "homes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "gross_area_sf": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$"
        },
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "rationale",
            "reference_ids"
          ],
          "properties": {
            "kind": {
              "enum": [
                "analyst_assumption",
                "reported_input",
                "source_derived_input"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "reference_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              }
            }
          }
        }
      }
    },
    "capital": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lines"
      ],
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "measure",
              "usd",
              "basis"
            ],
            "properties": {
              "category": {
                "enum": [
                  "land",
                  "acquisition_closing",
                  "demolition",
                  "remediation",
                  "hard_costs",
                  "hard_contingency",
                  "soft_costs",
                  "soft_contingency",
                  "offsite_infrastructure",
                  "construction_interest",
                  "taxes_and_carry",
                  "business_relocation",
                  "financing_fees",
                  "developer_fee",
                  "initial_reserves",
                  "other"
                ]
              },
              "measure": {
                "enum": [
                  "fixed",
                  "per_home",
                  "per_gross_sf"
                ]
              },
              "usd": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$"
              },
              "basis": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "rationale",
                  "reference_ids"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "analyst_assumption",
                      "reported_input",
                      "source_derived_input"
                    ]
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "reference_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 10000
                    }
                  }
                }
              }
            }
          },
          "minItems": 16,
          "maxItems": 16
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_calendar_year",
        "horizon_years",
        "income",
        "expenses",
        "replacement_reserve",
        "reserve_deducted_for_coverage",
        "below_line"
      ],
      "properties": {
        "first_calendar_year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2200
        },
        "horizon_years": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "income": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "annual_usd",
              "annual_growth",
              "basis",
              "vacancy_rate",
              "start_year",
              "end_year"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "annual_usd": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$"
              },
              "annual_growth": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$"
              },
              "basis": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "rationale",
                  "reference_ids"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "analyst_assumption",
                      "reported_input",
                      "source_derived_input"
                    ]
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "reference_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 10000
                    }
                  }
                }
              },
              "vacancy_rate": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$"
              },
              "start_year": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "end_year": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            }
          },
          "minItems": 1,
          "maxItems": 100
        },
        "expenses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "annual_usd",
              "annual_growth",
              "basis"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "annual_usd": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$"
              },
              "annual_growth": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$"
              },
              "basis": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "rationale",
                  "reference_ids"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "analyst_assumption",
                      "reported_input",
                      "source_derived_input"
                    ]
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "reference_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 10000
                    }
                  }
                }
              }
            }
          },
          "minItems": 1,
          "maxItems": 100
        },
        "replacement_reserve": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "annual_usd",
            "annual_growth",
            "basis"
          ],
          "properties": {
            "annual_usd": {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$"
            },
            "annual_growth": {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$"
            },
            "basis": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "rationale",
                "reference_ids"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "analyst_assumption",
                    "reported_input",
                    "source_derived_input"
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                },
                "reference_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  }
                }
              }
            }
          }
        },
        "reserve_deducted_for_coverage": {
          "type": "boolean"
        },
        "below_line": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "annual_usd",
              "annual_growth",
              "basis"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "annual_usd": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$"
              },
              "annual_growth": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$"
              },
              "basis": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "rationale",
                  "reference_ids"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "analyst_assumption",
                      "reported_input",
                      "source_derived_input"
                    ]
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "reference_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 10000
                    }
                  }
                }
              }
            }
          },
          "maxItems": 100
        }
      }
    },
    "debt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annual_interest_rate",
        "amortization_years",
        "term_years",
        "minimum_dscr",
        "sizing_years",
        "maximum_total_ltc",
        "maximum_ltv",
        "appraised_value_usd",
        "absolute_cap_usd",
        "other_annual_debt_service_usd",
        "basis",
        "minimum_dscr_by_year"
      ],
      "properties": {
        "annual_interest_rate": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$"
        },
        "amortization_years": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "term_years": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "minimum_dscr": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$"
        },
        "sizing_years": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "maximum_total_ltc": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "maximum_ltv": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "appraised_value_usd": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "absolute_cap_usd": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "other_annual_debt_service_usd": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$"
        },
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "rationale",
            "reference_ids"
          ],
          "properties": {
            "kind": {
              "enum": [
                "analyst_assumption",
                "reported_input",
                "source_derived_input"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "reference_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              }
            }
          }
        },
        "minimum_dscr_by_year": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 40,
              "items": {
                "type": "string",
                "pattern": "^(?:[1-4](?:\\.[0-9]{1,12})?|5(?:\\.0{1,12})?)$"
              }
            }
          ]
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "amount_usd",
          "status",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "kind": {
            "enum": [
              "equity",
              "grant",
              "soft_loan",
              "other"
            ]
          },
          "amount_usd": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$"
          },
          "status": {
            "enum": [
              "committed",
              "proposed"
            ]
          },
          "basis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "rationale",
              "reference_ids"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "analyst_assumption",
                  "reported_input",
                  "source_derived_input"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "reference_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                }
              }
            }
          }
        }
      },
      "maxItems": 100
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "rationale",
        "reference_ids"
      ],
      "properties": {
        "kind": {
          "enum": [
            "analyst_assumption",
            "reported_input",
            "source_derived_input"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "reference_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url",
          "locator"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        }
      }
    }
  }
}
