{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-housing-toolkit.local/housing-feasibility/brief-1.0.schema.json",
  "title": "Run brief",
  "description": "Started before any work; appended as the user decides. Write it with python -m housing_feasibility brief start|provide|decide.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "goal", "persona", "provided", "decisions"],
  "properties": {
    "version": {"const": "1.0"},
    "goal": {"type": "string", "minLength": 1, "maxLength": 1000, "description": "The user's goal, quoted in their words"},
    "persona": {"enum": ["housing_agency", "developer", "community", "other"]},
    "provided": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["label", "value"],
      "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 40}, "value": {"type": "string", "minLength": 1, "maxLength": 160}}}},
    "extends": {"type": "array", "description": "Earlier reports this run continues (written by housing_feasibility continue)",
      "items": {"type": "object", "additionalProperties": false, "required": ["title", "evidence_fingerprint", "prepared_on"],
        "properties": {"title": {"type": "string"}, "evidence_fingerprint": {"type": "string"}, "prepared_on": {"type": "string"}}}},
    "notes": {"type": "array", "maxItems": 12, "description": "The agent's own notes, printed in the report's last appendix (housing_feasibility brief note)",
      "items": {"type": "object", "additionalProperties": false, "required": ["kind", "step", "text"],
        "properties": {"kind": {"enum": ["friction", "data_issue", "assumption_concern", "idea"]}, "step": {"type": "string"},
          "text": {"type": "string", "minLength": 1, "maxLength": 300}}}},
    "decisions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["step", "proposed", "answer", "decided_on"],
      "properties": {"step": {"type": "string", "description": "One or more of search, activity, select, research, massing, financing, render, report, other, comma-separated"},
        "proposed": {"type": "string", "minLength": 1, "maxLength": 280, "description": "What the agent proposed"},
        "answer": {"type": "string", "minLength": 1, "maxLength": 600, "description": "The user's answer, in their words"},
        "decided_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}}}
  }
}
