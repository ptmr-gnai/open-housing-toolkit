{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "question",
    "scope",
    "display_per_group"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,80}$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "display_per_group": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "borough",
        "bbox"
      ],
      "properties": {
        "borough": {
          "enum": [
            "BX",
            "BK",
            "MN",
            "QN",
            "SI"
          ]
        },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        }
      }
    }
  }
}
