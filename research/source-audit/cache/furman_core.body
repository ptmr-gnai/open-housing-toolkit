						<article class="card card-event fur-relative">
  <div class="card-content fur-flex fur-flex-col fur-gap-4">
    <div class="card-meta fur-flex fur-flex-col fur-gap-1">
							<ul class="card-tags fur-list-none fur-flex fur-flex-wrap fur-gap-x-3 fur-gap-y-0">
