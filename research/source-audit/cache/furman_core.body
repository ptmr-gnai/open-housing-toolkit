      <main id="main" class="main">
               <article class="post-8986 data-tool type-data-tool status-publish hentry">
  
<style>
    .wp-block-fur-hero-banner .fur-breadcrumbs {
        --link-color: var(--wp--preset--color--white);
    }

    </style>

<header class="wp-block-fur-hero-banner js-hero-banner alignfull fur-bg-purple data-tool-hero ">
    
    <div class="fur-container fur-flex fur-flex-col md:fur-flex-row fur-gap-y-8 fur-gap-x-8 md:fur-gap-x-6 lg:fur-gap-x-14 fur-flex-wrap md:fur-items-end">
                    <hr class="fur-border-t-[3px] fur-border-b fur-border-orange fur-h-[7px] fur-w-full">
        
        
        <div class="md:fur-flex-1 fur-flex fur-flex-col fur-max-w-[900px]">
            <p class="hero-banner-breadcrumbs fur-breadcrumbs fur-mb-8 fur-text-white"><span><span><a href="https://www.furmancenter.org/">Home</a></span>  <span><a href="https://www.furmancenter.org/data-tools-resources/">Data Tools & Resources</a></span></span></p>
            <div class="fur-flex fur-flex-col fur-gap-8 ">
                
                
                                    <p class="fur-detail fur-max-w-[700px] fur-text-white">
                        Tool Overview                    </p>
                
                
                
                
                <h1 class="fur-title--heading-1 fur-max-w-[970px] fur-text-white">
                    CoreData.nyc                </h1>

