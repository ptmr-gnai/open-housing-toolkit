<td width="80" valign="middle" bgcolor="#999999"><p><strong> 2 Person </strong></p></td> 
<td width="80" valign="middle" bgcolor="#999999"><p><strong> 3 Person </strong></p></td> 
<td width="80" valign="middle" bgcolor="#999999"><p><strong> 4 Person </strong></p></td> 
<td width="80" valign="middle" bgcolor="#999999"><p><strong> 5 Person </strong></p></td> 
<td width="80" valign="middle" bgcolor="#999999"><p><strong> 6 Person </strong></p></td> 
<td width="80" valign="middle" bgcolor="#999999"><p><strong> 7 Person </strong></p></td> 
<td width="80" valign="middle" bgcolor="#999999"><p><strong> 8 Person </strong></p></td> </tr> 

<tr> <td width="80" height="57" valign="middle" bgcolor="#E5E5E5"><p>$18,050</p></td> 
<td width="80" valign="middle" bgcolor="#E5E5E5"><p>$20,650</p></td> 
<td width="80" valign="middle" bgcolor="#E5E5E5"><p>$23,200</p></td> 
<td width="80" valign="middle" bgcolor="#E5E5E5"><p><strong><em>$25,800 </em></strong></p></td>
 <td width="80" valign="middle" bgcolor="#E5E5E5"><p> $27,850 </p></td> 
