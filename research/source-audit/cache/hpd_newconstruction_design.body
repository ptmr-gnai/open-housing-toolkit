<div class="ls-cmp-wrap" id="w1456871101034">
<!--ls:begin[component-1456871101034]-->
<div class="iw_component" id="1456871101034"><!-- Left nav component --><div class="row">
<div class="container content-container">
<div class="span3 agencies-about-links">
<div class="agencies-about-share">
<div class="share">
<a target="_blank" href="#"><span class="facebook_custom" data-url="http://10.155.43.177:8004/site/hpd/services-and-information/new-construction-design.page?" data-title="New Construction Design - HPD"></span></a><a target="_blank" href="#"><span class="twitter_custom" data-url="http://10.155.43.177:8004/site/hpd/services-and-information/new-construction-design.page?" data-title="New Construction Design - HPD"></span></a><a target="_blank" href="#"><span class="googleplus_custom" data-url="http://10.155.43.177:8004/site/hpd/services-and-information/new-construction-design.page?" data-title="New Construction Design - HPD"></span></a><a target="_blank" href="#"><span class="tumblr_custom" data-url="http://10.155.43.177:8004/site/hpd/services-and-information/new-construction-design.page?" data-title="New Construction Design - HPD"></span></a><a href="#"><span class="email_custom" data-url="http://10.155.43.177:8004/site/hpd/services-and-information/new-construction-design.page?" data-title="New Construction Design - HPD"></span></a>Share</div>
