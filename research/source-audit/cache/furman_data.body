					<div class="swiper-slide component-items-list-item">
						<article class="card card-news fur-relative">
  <div class="card-content fur-flex fur-flex-col fur-gap-4">
    <div class="card-meta fur-flex fur-flex-col fur-gap-1">
							<ul class="card-tags fur-list-none fur-flex fur-flex-wrap fur-gap-x-3 fur-gap-y-0">
      <li class="">
              <a href="https://www.furmancenter.org/news-announcements/?term-news-type=publication-announcement" class="fur-detail fur-text-black">
              Publication Announcement
              </a>
          </li>
  </ul>
			
			<time class="card-date fur-detail fur-text-purple-light" datetime="2015-11-10T01:05:00+00:00">
        Nov 9 2015
      </time>
    </div>

    <h3 class="card-heading fur-title--heading-5">
      <a href="https://www.furmancenter.org/news/421-a-impact-on-future-housing-construction-in-nyc/" class="fur-text-purple fur-no-underline fur-transition-colors fur-duration-200 hover:fur-text-orange">
        421-A Impact On Future Housing Construction In NYC
      </a>
    </h3>

    
		      <ul class="card-tags fur-list-none fur-flex fur-flex-wrap fur-gap-x-3 fur-gap-y-0">
      <li class="">
              <a href="https://www.furmancenter.org/news-announcements/?term-topic=housing-finance" class="fur-tag-purple">
              Housing Finance
              </a>
          </li>
      <li class="">
              <a href="https://www.furmancenter.org/news-announcements/?term-topic=property-taxes-and-tax-incentives" class="fur-tag-purple">
              Property Taxes and Tax Incentives
              </a>
          </li>
      <li class="">
              <a href="https://www.furmancenter.org/news-announcements/?term-topic=rental-housing-finance" class="fur-tag-purple">
              Rental Housing Finance
              </a>
          </li>
  </ul>
      </div>

	</article>
					</div>
									
					<div class="swiper-slide component-items-list-item">
						<article class="card card-publication fur-relative">
  <div class="card-content fur-flex fur-flex-col fur-gap-4">
    <div class="card-meta fur-flex fur-flex-col fur-gap-1">
							<ul class="card-tags fur-list-none fur-flex fur-flex-wrap fur-gap-x-3 fur-gap-y-0">
      <li class="">
              <a href="https://www.furmancenter.org/publications/?term-publication-type=brief" class="fur-detail fur-text-black">
              Brief
              </a>
