            <tr>
                <td>
                    <p>state_name</p>
                </td>
                <td>
                    <p>string</p>
                </td>
                <td>
                    <p>State name</p>
                </td>
            </tr>
            <tr>
                <td>
                    <p>state_code</p>
                </td>
                <td>
                    <p>string</p>
                </td>
                <td>
                    <p>State code</p>
                </td>
            </tr>
            <tr>
