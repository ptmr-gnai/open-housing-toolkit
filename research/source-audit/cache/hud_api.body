                    <p>state_num</p>
                </td>
                <td>
                    <p>string</p>
                </td>
                <td>
                    <p>State number</p>
                </td>
            </tr>
            <tr>
                <td>
                    <p>category</p>
                </td>
                <td>
                    <p>string</p>
                </td>
                <td>
                    <p>Value is "State"</p>
                </td>
            </tr>
        </tbody>
    </table>

