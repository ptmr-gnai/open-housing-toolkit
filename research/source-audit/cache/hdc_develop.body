            <div class="field field--name-field-caption field--type-string field--label-hidden field__item">1921 Atlantic Avenue, Brooklyn</div>
      
      </div>


  <div class="quote-slider-slide">
          
            <div class="field field--name-field-image field--type-entity-reference field--label-hidden field__item"><div>
  
  
            <div class="field field--name-field-media-image field--type-image field--label-hidden field__item">    <picture>
                  <source srcset="/sites/default/files/styles/quote_slider_desktop_1x/public/2022-12/WES02401-for-website.jpg?itok=F751wPGg 1x, /sites/default/files/styles/quote_slider_desktop_2x/public/2022-12/WES02401-for-website.jpg?itok=J4XKhE8C 2x" media="(min-width: 1200px)" type="image/jpeg" width="1000" height="668"/>
              <source srcset="/sites/default/files/styles/quote_slider_mobile_1x/public/2022-12/WES02401-for-website.jpg?itok=zIQt2zIq 1x, /sites/default/files/styles/quote_slider_mobile_2x/public/2022-12/WES02401-for-website.jpg?itok=rKHxABpd 2x" type="image/jpeg" width="480" height="320"/>
                  <img loading="eager" src="/sites/default/files/styles/quote_slider_mobile_1x/public/2022-12/WES02401-for-website.jpg?itok=zIQt2zIq" width="480" height="320" alt="PACT Brooklyn Bundle II" typeof="foaf:Image" />

  </picture>

