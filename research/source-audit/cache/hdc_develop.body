<article about="/develop" class="node node--type-layout-develop layout-develop">
  
            <div class="field field--name-field-hero-develop field--type-entity-reference-revisions field--label-hidden field__item">


	
  <div class="paragraph paragraph--type--hero paragraph--view-mode--default has-background-image">
    							<div class="bg-img" style="background-image: url(/sites/default/files/styles/hero_image_desktop/public/2020-06/develop-hero.jpg?itok=zbOPyTy0)"></div>
			
  		<div class="container">
  			<div class="standard-container">
  				<h1>Develop</h1>
  			</div>
  		</div>
      </div>
</div>
      
  
            <div class="field field--name-field-introduction-develop field--type-entity-reference-revisions field--label-hidden field__item">



  <div class="paragraph paragraph--type--text-introduction paragraph--view-mode--default">
    		<div class="container">
			<div class="narrow-container">
                  <h2 class="no-top-margin">Develop Affordable Housing</h2>
                
            <div class="field field--name-field-content field--type-text-long field--label-hidden field__item"><p>HDC is helping to create&nbsp;a more diverse and equitable city through the development of affordable housing. From the creation and preservation of affordable homes under the City's housing plan, to helping to preserve our city’s aging public housing stock under the <strong><a href="https://www1.nyc.gov/site/nycha/about/pact.page" target="_blank">NYCHA PACT</a></strong> program, HDC is always seeking to expand its reach by forging creative partnerships with mission-driven development teams, including local nonprofit and M/WBE entities.</p></div>
      
                
      </div>
		</div>
      </div>
</div>
      
  
            <div class="field field--name-field-slider-with-quote field--type-entity-reference-revisions field--label-hidden field__item">


  <div class="paragraph paragraph--type--slider-with-quote paragraph--view-mode--default">
          <div class="container">
        <div class="slider-inner">
          <div class="left">
            <div class="green-box bg-bright-green">
              <div class="inner">
                                  
            <div class="field field--name-field-quote-content field--type-string-long field--label-hidden field__item">“HDC strives to strengthen our city through the development of housing that is affordable and secure. Our success depends upon effective public-private partnerships and we proactively foster more inclusive and equitable opportunities through engagement with M/WBE and nonprofit partners.”</div>
      
                                                  
            <div class="field field--name-field-byline-name field--type-string field--label-hidden field__item">Ruth Moreira</div>
      
                                
            <div class="field field--name-field-byline-title field--type-string field--label-hidden field__item">First Executive Vice President</div>
      
              </div>
            </div>
          </div>
          <div class="right">
            <div class="slider">
              

  <div class="quote-slider-slide">
          
            <div class="field field--name-field-image field--type-entity-reference field--label-hidden field__item"><div>
  
  
            <div class="field field--name-field-media-image field--type-image field--label-hidden field__item">    <picture>
                  <source srcset="/sites/default/files/styles/quote_slider_desktop_1x/public/2022-12/1921-Atlantic.jpg?itok=5Yu880nI 1x, /sites/default/files/styles/quote_slider_desktop_2x/public/2022-12/1921-Atlantic.jpg?itok=SvREXhzv 2x" media="(min-width: 1200px)" type="image/jpeg" width="1000" height="752"/>
              <source srcset="/sites/default/files/styles/quote_slider_mobile_1x/public/2022-12/1921-Atlantic.jpg?itok=al2_H3l3 1x, /sites/default/files/styles/quote_slider_mobile_2x/public/2022-12/1921-Atlantic.jpg?itok=Pl6xYa7K 2x" type="image/jpeg" width="480" height="361"/>
                  <img loading="eager" src="/sites/default/files/styles/quote_slider_mobile_1x/public/2022-12/1921-Atlantic.jpg?itok=al2_H3l3" width="480" height="361" alt="1921 Atlantic Avenue, Brooklyn" typeof="foaf:Image" />

  </picture>

</div>
      
