</article>

    <div class="section-children">
        

<article role="article" about="/article-xiv/chapter-1/141-41" class="node node--type-section node--view-mode-default" id="141-41" data-section=141-41 data-node-id=20141>

    
    

        <div class="section-header-wrapper">
