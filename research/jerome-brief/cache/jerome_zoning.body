</span></span>
            <h3><a href="/article-xiv/chapter-1/141-25">Special Height and Setback Regulations in R8A Districts</a></h3>
        </div>

        <div class="action-links">
            <div class="box-dagger">
                <div class="views-element-container"><div class="view view-section-annotations view-id-section_annotations view-display-id-block_2 js-view-dom-id-26441b51898f35e1e11c9554ee40943fd9af5c7b6a410fcd1324b64098d670f2">
  
    
      
  
