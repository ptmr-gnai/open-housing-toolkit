            <div class="action-link"><a data-content-nid="20132" data-section-number="141-22" data-section-title="Special Floor Area Regulations in R8A Districts" title="Amendment History" class="use-ajax action-icon revisions" href="/nojs/get/amendment/section/20132">History</a></div>
