            <div class="amended"><div class="views-element-container"><div class="view view-amendment-history-popup view-id-amendment_history_popup view-display-id-last_amended_date js-view-dom-id-7a18dc000b20b5eea4398dd815de1389f1ea5f8bd89de24f7d56b7a7cf38fd83">
  
    
      
      <div class="view-content">
          <div class="views-row"><div class="views-field views-field-field-effective-date"><span class="views-label views-label-field-effective-date">Last Amended</span><div class="field-content"><time datetime="2024-12-05T12:00:00Z" class="datetime">12/5/2024</time>
</div></div></div>

    </div>
  
