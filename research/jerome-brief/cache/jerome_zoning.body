            <span class="section-link"><span class="section-number"><span class="field field--name-title field--type-string field--label-hidden">141-41</span>
</span></span>
            <h3><a href="/article-xiv/chapter-1/141-41">Location of Curb Cuts</a></h3>
        </div>

        <div class="action-links">
            <div class="box-dagger">
                <div class="views-element-container"><div class="view view-section-annotations view-id-section_annotations view-display-id-block_2 js-view-dom-id-d1b67803128e601b8590fbabe05a28cdb92184770049e0b11e438aaf06fba59f">
  
    
      
  
          </div>
</div>

            </div>
            <div class="amended"><div class="views-element-container"><div class="view view-amendment-history-popup view-id-amendment_history_popup view-display-id-last_amended_date js-view-dom-id-aaf238f7b0dbe11073819754c6fed1f2540fceee22eb7896ced01857bdbde1b3">
  
    
      
      <div class="view-content">
          <div class="views-row"><div class="views-field views-field-field-effective-date"><span class="views-label views-label-field-effective-date">Last Amended</span><div class="field-content"><time datetime="2018-03-22T12:00:00Z" class="datetime">3/22/2018</time>
</div></div></div>

