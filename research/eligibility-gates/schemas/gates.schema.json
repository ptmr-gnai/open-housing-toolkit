{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-bound pursuit gates DSL v0.1",
  "type": "object",
  "properties": {
    "dsl_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "cutoff": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "next_action": {
                "type": "string",
                "minLength": 1
              },
              "interpretation": {
                "type": "string",
                "minLength": 1
              },
              "citations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "source_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pdf_page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "source_id",
                    "pdf_page",
                    "quote"
                  ],
                  "additionalProperties": false
                }
              },
              "kind": {
                "const": "review"
              }
            },
            "required": [
              "id",
              "label",
              "owner",
              "next_action",
              "interpretation",
              "citations",
              "kind"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "next_action": {
                "type": "string",
                "minLength": 1
              },
              "interpretation": {
                "type": "string",
                "minLength": 1
              },
              "citations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "source_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pdf_page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "source_id",
                    "pdf_page",
                    "quote"
                  ],
                  "additionalProperties": false
                }
              },
              "kind": {
                "const": "experience"
              },
              "collection": {
                "enum": [
                  "development",
                  "management"
                ]
              },
              "where": {
                "$ref": "#/$defs/expression"
              },
              "bindings": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "citation_index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "regex": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "value": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "id",
                    "citation_index",
                    "regex",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "on_no_match": {
                "enum": [
                  "fail",
                  "agency_review"
                ]
              },
              "discretion_citation": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            },
            "required": [
              "id",
              "label",
              "owner",
              "next_action",
              "interpretation",
              "citations",
              "kind",
              "collection",
              "where",
              "bindings",
              "on_no_match",
              "discretion_citation"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "threshold_gate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "full_submission_inventory_review": {
          "enum": [
            "pending",
            "accepted"
          ]
        },
        "unexpanded": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "threshold_gate_ids",
        "full_submission_inventory_review",
        "unexpanded"
      ],
      "additionalProperties": false
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "dsl_version",
    "id",
    "title",
    "cutoff",
    "gates",
    "coverage",
    "assumptions",
    "limits"
  ],
  "additionalProperties": false,
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "eq"
            },
            "field": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "field",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "gte"
            },
            "field": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "integer",
              "minimum": 1
            },
            "binding": {
              "type": "string",
              "minLength": 1
            },
            "unit": {
              "const": "dwelling_units"
            }
          },
          "required": [
            "op",
            "field",
            "value",
            "binding",
            "unit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "within_years"
            },
            "field": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "integer",
              "minimum": 1
            },
            "binding": {
              "type": "string",
              "minLength": 1
            },
            "unit": {
              "const": "calendar_years"
            }
          },
          "required": [
            "op",
            "field",
            "value",
            "binding",
            "unit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "in"
            },
            "field": {
              "type": "string",
              "minLength": 1
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "domain": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "op",
            "field",
            "values",
            "domain"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "all"
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "any"
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
