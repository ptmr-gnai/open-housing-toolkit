                  <img loading="eager" src="/sites/default/files/styles/max_890/public/2022-11/20221102%20425%20Grand%20Concourse%20RC%20%2838%29.JPG?itok=vCGcdbPp" width="890" height="668" alt="ribbon cutting ceremony at 425 Grand Concourse, The Bronx " typeof="foaf:Image" />

