    <style> .cookie-consent-dialog {
        background: #e4f3f7;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
		border: 1px solid #066CAB;
        bottom: 0;
        display: none;
        left: 5%;
        position: fixed;
        right: 5%;
        z-index: 10000;
    }
	
	.cookie-consent-dialog .inner {
            padding: 0 20px 20px;
        }
	
	#consent-popup h2 {
		font-size:18.5px;
		font-weight: bold;
	}

    #consent-popup a:focus {
		outline: 1px solid #066CAB;
	}

	
	#consent-popup button.tw-button:focus {
		outline: 2px solid #066CAB;
		outline-offset: 2px;
    }
	
	#consent-popup button.tw-button:hover {
     background: #000000;
   }

    a.tw-button, button.tw-button {
        align-items: center;
        display: flex;
        justify-content: center;
    }

    .tw-inline-flex {
        display: inline-flex !important
    }

    .tw-button {
        border-radius: var(--btn-radius, 9999px) !important;
        border-style: inherit;
        font-size: var(--btn-font-size, 1.5rem);
        font-weight: 700;
        line-height: var(--btn-line-height, 1.66rem);
        padding: var(--btn-padding-y, .5rem) var(--btn-padding-x, 1.25rem);
        cursor: pointer;
       /* margin-left:1.714rem;*/
    }

    .tw-button--primary {
        --tw-bg-opacity: 1;
        fill: #fff;
        --tw-text-opacity: 1;
        background-color: rgb(0 84 129 / var(--tw-bg-opacity));
        color: rgb(255 255 255 / var(--tw-text-opacity));
    }</style>
</head>

