        .nys-global-header.vertical > ul li ul li a:active {
            font-size: 13px;
            line-height: 17px;
            font-weight: 600;
            padding-right: 25px !important;
        }
    }


    @media (min-width:768px) and (max-width:920px) {
        .nav-item__header {
            padding: 8px 5px 8px 6px;
        }

        .nav-container li:first-child .nav-item__header {
            padding: 8px 5px 8px 10px;
        }

        .nav-container li:last-child .nav-item__header {
            padding: 8px 10px 8px 6px;
        }

        .nyserda-home .utility-nav .utility-column-1 {
            display: none;
        }

        .nys-global-header.unstacked.horizontal h1 a,
        .nys-global-header.unstacked.horizontal h1 a:link {
            padding: 15px 30px 1px 10px;
        }
    }

    @media (min-width:921px) {
        .nav-item__header {
            padding: 8px 10px 8px 10px;
        }
    }

    @media (min-width:921px) and (max-width:1164px) {
        .nav-container > li:first-child {
            padding-left: 15px;
        }
    }

    @media (min-width:768px) and (max-width:810px)  {
        .utility-column-2 {
            max-width:145px;
        }
        .subscribe_description > span:nth-child(2) {
            padding-top: 0;
        }
    }

    @media (min-width: 768px) and (max-width:1023px) {
        .height-utility-nav {
            margin-top: 5px;
        }
    }



    @media (min-width: 768px) and (max-width:1165px) {
        .nav-container {
            height: 70px;
            align-items: stretch;
        }
    }



</style>


<script>
    //Mobile Menu Toggle visibility of sections
    $(document).ready(function () {

        //clean these buttons - they are being affected by another function somehwere // ... somewhere is in the other ... here :)
        $(".menu-section").unbind(); $(".menu-button").unbind();

        // toggle child menus
        $(".menu-section").click(function () {
    
            //if aria expanded is true - remove show from my descendants
            var ariaExpandedState = $(this).attr('aria-expanded');       
            if (ariaExpandedState == 'true') {
                    $(this).siblings("ul").find("ul").removeClass("show");
            }

            //toggle aria
            $(this).attr('aria-expanded', function (i, attr) {
                return attr == 'true' ? 'false' : 'true';
            });

            //the ul is a sibling, toggle the collapse
            $(this).siblings("ul").collapse("toggle");

            // console.log("I should fire once");
        });

        // toggle menu buttons (desktop)
        $(".menu-button").click(function () {
            var ariaExpandedOnMenuButton = $(this).attr('aria-expanded');
            if (ariaExpandedOnMenuButton == 'true') {
                $(this).attr('aria-expanded', 'false');
            } else {
                $(".menu-button").attr('aria-expanded', 'false');
                $(this).attr('aria-expanded', 'true');
            }

            // console.log("I should fire once, not twice and absolutely not four times :)");
        });

    });
</script>


