    <script>$(document).ready(function(){$('[data-toggle], [data-dismiss], [data-target], [data-slide], [data-slide-to]').each(function(){if($(this).attr('data-toggle')){$(this).attr('data-bs-toggle',$(this).attr('data-toggle'));$(this).removeAttr('data-toggle')}if($(this).attr('data-dismiss')){$(this).attr('data-bs-dismiss',$(this).attr('data-dismiss'));$(this).removeAttr('data-dismiss')}if($(this).attr('data-target')){$(this).attr('data-bs-target',$(this).attr('data-target'));$(this).removeAttr('data-target')}if($(this).attr('data-slide')){$(this).attr('data-bs-slide',$(this).attr('data-slide'));$(this).removeAttr('data-slide')}if($(this).attr('data-slide-to')){$(this).attr('data-bs-slide-to',$(this).attr('data-slide-to'));$(this).removeAttr('data-slide-to')}})});</script>


<script type="text/javascript">
jQuery(document).ready(function($) {
var wrapper_selector = '.gtranslate_wrapper';
var customwidgetcode =  '<div class="gt_switcher">';
var languageValue = $('#languageText').text();
customwidgetcode += '<div class="gt_selected"><a href="#" id="languageToggle" role="button" aria-expanded="false" aria-controls="languageOptions" aria-haspopup="true">'+languageValue+'</a></div>';
customwidgetcode += '<ul id="languageOptions" class="language-options gt_closed notranslate"></ul></div>';

document.querySelectorAll(wrapper_selector).forEach(function(e){e.innerHTML+=customwidgetcode});

const languageToggle = document.getElementById('languageToggle');
const languageOptions = document.getElementById('languageOptions');
const hiddenOptions = document.querySelector('.gt_option');

function populateLanguageOptions() { const options = hiddenOptions.querySelectorAll('a'); options.forEach((option, index) => { const li = document.createElement('li'); const a = option.cloneNode(true); a.removeAttribute('title'); a.setAttribute('lang', a.getAttribute('data-gt-lang')); a.href = option.getAttribute('href'); a.setAttribute('tabindex', '0'); li.appendChild(a); languageOptions.appendChild(li); }); 
languageOptions.querySelectorAll('a img:not([src])').forEach(function(img){img.setAttribute('src', img.getAttribute('data-gt-lazy-src'));});
}
populateLanguageOptions();
$(".gtranslate_wrapper").find(".gt_switcher:first-child").remove();

	$('#languageToggle').click(function() {
		languageOptions.classList.toggle('gt_closed');
                const expanded = $(this).attr('aria-expanded') === 'true';
                $(this).attr('aria-expanded', !expanded);
            	});

	$('#languageOptions').on('keydown', 'a', function(e) {
		const links = $('#languageOptions a');
		let index = links.index(this);

		if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
			e.preventDefault();
			links.eq((index + 1) % links.length).focus();
		} else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
			e.preventDefault();
			links.eq((index - 1 + links.length) % links.length).focus();
		}  else if (e.key === 'Escape') {
	            languageOptions.classList.add('gt_closed');
	            $('#languageToggle').attr('aria-expanded', 'false').focus();
	        } else if (e.key === 'Tab') {
	            if (!e.shiftKey && index === links.length - 1) {
	                languageOptions.classList.add('gt_closed');
	                $('#languageToggle').attr('aria-expanded', 'false');
	            } else if (e.shiftKey && (index === 0 || index === 1)) {
	                languageOptions.classList.add('gt_closed');
	                $('#languageToggle').attr('aria-expanded', 'false');
	            }
	        }
	});

	$('#languageToggle').on('keydown', function(e) {
		if(e.key === 'Tab' && e.shiftKey) {
			languageOptions.classList.add('gt_closed');
			$('#languageToggle').attr('aria-expanded', 'false').focus();
		}
	});

});

jQuery(document).keyup(function(e) {
     if (e.keyCode == 27) {    
              const languageOptions = document.getElementById('languageOptions');
              var isLanguageOpen = languageOptions.classList.contains('gt_closed');
              if(!isLanguageOpen){
                       languageOptions.classList.toggle('gt_closed');
                       $('#languageToggle').attr('aria-expanded', 'false');    
              }
    }
});
 
$(document).on("click", function(event){
        var $trigger = $("#languageToggle");
        if($trigger[0] !== event.target && !$trigger.has(event.target).length){
                const languageOptions = document.getElementById('languageOptions');        
                languageOptions.classList.add('gt_closed');
                       $('#languageToggle').attr('aria-expanded', 'false');    
        }            
    });

</script>

<style>
.gt_closed {display:none !important}
</style>
