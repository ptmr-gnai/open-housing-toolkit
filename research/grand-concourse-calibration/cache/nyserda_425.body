<script>
    var hexFormat = /^#([0-9a-f]{6,8}){1,2}$/i;
    var rgbFormat = /^(rgba|rgb)\(\s?\d{1,3}\,\s?\d{1,3}\,\s?\d{1,3}(\,\s?(\d|\d\.\d+))?\s?\)$/;
    
    // valid hex color
    if (hexFormat.test('#f3f6ff')) {
        var regDigit = /^#([0-9a-f]{8}){1,2}$/i;
        // valid 8 digit hex
        if (regDigit.test('#f3f6ff')) {
            $(".hero23-blue-7002d907-42ca-4c97-a294-a63a4cab052e").css({ "background-color": "#f3f6ff" });         
        }
        else {
            var backColorHexFormat = "#f3f6ffd9";            
            $(".hero23-blue-7002d907-42ca-4c97-a294-a63a4cab052e").css({ "background-color": backColorHexFormat });
        }
    }
    //valid rgb color
    else if (rgbFormat.test('#f3f6ff')) {
        // valid rgba code
        if (-1 == 0) {
            $(".hero23-blue-7002d907-42ca-4c97-a294-a63a4cab052e").css({ "background-color": "#f3f6ff" });
        }
        else {
            var appendRgbaColor = "#f3f6ff";
            $(".hero23-blue-7002d907-42ca-4c97-a294-a63a4cab052e").css({ "background-color": appendRgbaColor });           
        }
    }
</script>

