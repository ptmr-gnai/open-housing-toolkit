<script type="text/javascript">
    (function ($) {
        $(document).ready(function () {
            leavingNYSERDA();
        });

        function leavingNYSERDA() {
            var exclusions = [ '.gov','cvent.com','nyserda.wattplan.com','nyserda.az1.qualtrics.com','nyserda.seamlessdocs.com','nyserda.forms.govos.com','76westcompetition.ny.gov','nyserda-site.secure.force.com','76west.skild.com','energyfinancesolutions.com','eventbrite.com','www.nycleantransportationprizes.org','nyserdany.webex.com','nyserda.maps.arcgis.com','workforcenow.adp.com' ];
            var leaveSiteModalScript = '';
            $("a[href^=http]").each(function (index) {
                var href = this.getAttribute("href");
                //console.log(exclusions.length);
                for (var i = 0; i < exclusions.length; i++) {
                    if (href.indexOf(exclusions[i]) > -1) {
                        //console.log(exclusions[i]);
                        return;
                    }
                    //console.log(exclusions[i]);
                }

                if (leaveSiteModalScript) {
                    $(this).leaveNotice({
                        timeOut: 0,
                        externalSiteMessage: leaveSiteModalScript
                    });
                } else {
                    $(this).leaveNotice({
                        timeOut: 0,
                    });
                }
            });
        }
    })(jQuery);
</script>












