        <script src="/Assets/Search/Scripts/SearchAutocomplete.js"></script>

<script type="text/javascript">

    $(document).ready(function () {

        var acSelectedIndex = -1;

        const autoCompleteJS = new autoComplete({
            selector: "#searchvalue",
            wrapper: false,
            threshold: 3,
            debounce:300,
            data: {
                src: async (query) => {
                    const source = await fetch("/api/sitecore/Search/SearchAutoSuggest?term=" + query);
                    return await source.json();
                }
            },
            resultsList: {
                tag: "ul",
                id: "search-ac-list",
                maxResults: 10,
                element: (list, data) => {
                    list.setAttribute("aria-labelledby", "btn-b503416b-cd37-4376-993d-0f27a0335f45")
                }
            },
            resultItem: {
                tag: "li",
                element: (item, data) => {
                    item.setAttribute("role", "option");
                    item.setAttribute("aria-selected", "false");
                }
            },
        });

        document.querySelector("#searchvalue").addEventListener("open", function (event) {
            acSelectedIndex = -1;
        });

        document.querySelector("#searchvalue").addEventListener("close", function (event) {
            $("#search-ac-list > li").attr("aria-selected", "false");
            if (acSelectedIndex > -1) {
                $("#search-ac-list > li:eq(" + acSelectedIndex + ")").attr("aria-selected", "true");
            }
        });

        document.querySelector("#searchvalue").addEventListener("navigate", function (event) {
            $("#search-ac-list > li").removeClass("selected");
            acSelectedIndex = event.detail.cursor;
            $("#search-ac-list > li:eq(" + acSelectedIndex + ")").addClass("selected");
        });

        document.querySelector("#searchvalue").addEventListener("selection", function (event) {
            if (event && event.detail) {
                acSelectedIndex = event.detail.cursor;
                if (acSelectedIndex) {
                    $("#search-ac-list > li:eq(" + acSelectedIndex + ")").attr("aria-selected", "true");
                }
                var text = event.detail.selection.value;
                $("#search-ac-live").html(text + " selected.");
                $("#searchvalue").val(text);
            }
        });

        document.querySelector("#searchvalue").addEventListener("results", function (event) {
            if (event && event.detail && event.detail.matches) {
                $("#search-ac-live").html("Found " + event.detail.matches.length + " results. Press the down arrow key to select an option.");
            } else {
                $("#search-ac-live").html("");
            }
            acSelectedIndex = -1;
        });

    });
</script>
