                "assessments"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "commitment_status": {
            "const": "proposed"
          },
          "delivery": {
            "const": "unknown"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9_]{0,47}$",
            "type": "string"
          },
          "label": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "profile_counts": {
            "items": {
