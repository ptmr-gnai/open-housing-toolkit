          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "author",
        "text"
      ],
      "type": "object"
    },
    "overall_ranking": {
      "type": "null"
    },
    "price_year": {
      "maximum": 2200,
      "minimum": 1900,
      "type": "integer"
    },
    "professional_review": {
      "const": "pending"
    },
    "profiles": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "annual_income_claim": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "bedroom_claim": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "bedrooms": {
            "maximum": 5,
            "minimum": 0,
            "type": "integer"
          },
          "household_size": {
            "maximum": 8,
            "minimum": 1,
            "type": "integer"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9_]{0,47}$",
            "type": "string"
          },
          "income_reference_id": {
            "pattern": "^[a-z][a-z0-9_]{0,47}$",
            "type": "string"
          },
          "label": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "monthly_budget_claim": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "population_status": {
            "const": "hypothetical_not_observed"
          },
          "rationale": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "household_size",
          "bedrooms",
          "income_reference_id",
          "rationale",
          "annual_income_claim",
          "bedroom_claim",
          "monthly_budget_claim",
          "population_status"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "programs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bins": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "assessments": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "bedroom_test_claim": {
                        "maxLength": 4000,
                        "minLength": 1,
