{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "basis": {
      "const": "illustrative_program_comparison"
    },
    "claims": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "unknown"
                }
              }
            },
            "then": {
              "properties": {
                "rationale": {
                  "maxLength": 4000,
                  "minLength": 1,
                  "type": "string"
                },
                "value": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "fact"
                }
              }
            },
            "then": {
              "properties": {
                "references": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "assumption"
                }
              }
            },
            "then": {
              "properties": {
                "rationale": {
                  "maxLength": 4000,
                  "minLength": 1,
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "calculation"
                }
              }
            },
            "then": {
              "properties": {
                "method": {
                  "enum": [
                    "housing.bedroom_match@1",
                    "housing.cost_and_bedroom_match@1",
                    "housing.gross_monthly_cost@1",
                    "housing.annualize@1",
                    "housing.cost_burden_percent@1",
                    "housing.within_threshold@1",
                    "housing.monthly_budget@1",
                    "housing.sum_homes@1",
                    "housing.selected_homes@1",
                    "housing.difference@1"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "not": {
                    "const": "unknown"
                  }
                },
                "unit": {
                  "enum": [
                    "homes",
                    "years",
                    "bedrooms"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "integer"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "not": {
                    "const": "unknown"
                  }
                },
                "unit": {
                  "enum": [
                    "boolean"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "boolean"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "not": {
                    "const": "unknown"
                  }
                },
                "unit": {
                  "enum": [
                    "USD per month",
                    "USD per year"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$",
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "not": {
                    "const": "unknown"
                  }
                },
                "unit": {
                  "enum": [
                    "percent"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
                  "type": "string"
                }
              }
            }
          }
        ],
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "inputs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "kind": {
            "enum": [
              "fact",
              "assumption",
              "calculation",
              "judgment",
              "unknown"
            ]
          },
          "label": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "method": {
            "type": [
              "string",
              "null"
            ]
          },
          "rationale": {
            "type": [
              "string",
              "null"
            ]
          },
          "references": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "unit": {
            "enum": [
              "homes",
              "bedrooms",
              "USD per month",
              "USD per year",
              "years",
              "percent",
              "boolean",
              "status"
            ]
          },
          "value": {
            "type": [
              "string",
              "integer",
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "label",
          "value",
          "unit",
          "inputs",
          "method",
          "rationale",
          "references"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "comparisons": {
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "claim": {
                "maxLength": 4000,
                "minLength": 1,
                "type": "string"
              },
              "metric": {
                "const": "explicit_total_homes"
              }
            },
            "required": [
              "metric",
              "claim"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "claim": {
                "maxLength": 4000,
                "minLength": 1,
                "type": "string"
              },
              "metric": {
                "const": "cost_test_homes"
              },
              "profile_id": {
                "pattern": "^[a-z][a-z0-9_]{0,47}$",
                "type": "string"
              }
            },
            "required": [
              "metric",
              "profile_id",
              "claim"
            ],
            "type": "object"
          }
        ]
      },
      "type": "array"
    },
    "eligibility": {
      "const": "not_determined"
    },
    "limitations": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "module": {
      "const": "housing-program-comparison"
    },
    "objective": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
