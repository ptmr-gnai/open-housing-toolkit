          },
          "on_missing": {
            "enum": [
              "block",
              "skip"
            ]
          },
          "rationale": {
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "enum": [
              "gross_sf",
              "net_sf",
              "share",
              "net_sf_per_home",
              "gross_sf_per_home",
              "home_equivalents",
              "recorded_lot_sf",
              "ratio"
