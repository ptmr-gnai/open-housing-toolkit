          }
        },
        "required": [
          "id",
          "label",
          "method",
          "inputs",
          "type",
          "rationale",
          "on_missing"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "version": {
      "const": "0.1.0"
    }
  },
  "required": [
    "version",
    "id",
    "revision",
    "name",
    "purpose",
    "parameters",
    "imports",
    "steps",
    "review_gates"
